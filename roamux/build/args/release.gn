# Roamux RELEASE build args (roam-33 / E6, plan §11.10, §13.6). Per-arch slices
# are built with target_cpu=arm64 and target_cpu=x64, then merged into a
# universal2 Roamux.app by chrome/installer/mac/universalizer.py.
# Use (roam-114 — never newline-flatten this file; a '#' would swallow the whole line):
#   gn gen out/Release-<cpu> --args="import(\"//roamux/build/args/release.gn\") target_cpu=\"<cpu>\""

is_chrome_branded = false        # unbranded (no Google keys; §7.3)
is_official_build = true         # release optimization + the packaged .app shape
is_debug = false
is_component_build = false       # a distributable single-framework bundle
symbol_level = 1
target_os = "mac"
# target_cpu is supplied per-slice on the gn gen command line (arm64 / x64).

# roam-116: the pinned checkout syncs without checkout_pgo_profiles, so official-build PGO
# would demand missing .profdata at gn gen. Personal-alpha skips PGO deliberately —
# a hermetic pinned checkout over the few-% perf.
chrome_pgo_phase = 0

# roam-32: bundle Sparkle + compile the updater in release artifacts.
roamux_enable_sparkle = true

# roam-238: ship proprietary codecs (H.264/AAC). Unbranded builds default these OFF
# (proprietary_codecs=false, ffmpeg_branding="Chromium"), which left the packaged app
# unable to play H.264/AAC — Microsoft Stream and most corporate video platforms fail
# their MSE capability probe. Licensing decision (scope: unsigned personal distribution,
# roam-229 lineage) is recorded in the roam-238 PR; this pair is the single revert point.
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# roam-241: shipped behavior must be deterministic — real flag defaults plus deliberate
# overrides only. Unbranded builds otherwise compile in the fieldtrial testing config
# (the gate ignores is_official_build): a pin-varying experiment soup that masked the
# E1 gate-mismatch family (roam-234/roam-239). Decision + per-pin feature inventory are
# recorded on roam-241 and in docs/adr/0002; this single arg is the revert point.
disable_fieldtrial_testing_config = true
