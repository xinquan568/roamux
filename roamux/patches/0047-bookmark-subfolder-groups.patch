+void BookmarksPageHandler::GetRoamuxSubfolderGroupCount(
+    const std::string& folder_id,
+    GetRoamuxSubfolderGroupCountCallback callback) {
+  // Roamux (roam-220, patch 0047): all gates live in
+  // roamux::GetQualifyingSubfolderCountForMenus; permanent-folder string IDs
+  // resolve to a parent holding no non-permanent node and report 0.
+  std::optional<BookmarkParentFolder> parent =
+      GetBookmarkParentFolderFromSidePanel(*bookmark_merged_surface_,
+                                           folder_id);
+  if (!parent || !parent->HoldsNonPermanentFolder()) {
+    std::move(callback).Run(0);
+    return;
+  }
+  Browser* browser = browser_window_interface_->GetBrowserForMigrationOnly();
+  std::move(callback).Run(roamux::GetQualifyingSubfolderCountForMenus(
+      browser ? browser->profile() : nullptr,
+      parent->as_non_permanent_folder()));
+}
+
+void BookmarksPageHandler::ExecuteRoamuxOpenSubfolderGroups(
+    const std::string& folder_id) {
+  // Roamux (roam-220, patch 0047): untrusted renderer input — re-resolve and
+  // revalidate everything browser-side immediately before acting.
+  std::optional<BookmarkParentFolder> parent =
+      GetBookmarkParentFolderFromSidePanel(*bookmark_merged_surface_,
+                                           folder_id);
+  if (!parent || !parent->HoldsNonPermanentFolder()) {
+    return;
+  }
+  roamux::ValidateAndOpenSubfolderGroups(
+      browser_window_interface_->GetBrowserForMigrationOnly(),
+      parent->as_non_permanent_folder());
+}
