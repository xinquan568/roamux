+
+std::string TaskTracker::DescribeIncompleteBlockShutdownTaskSourcesForTesting()
+    const {
+  // Snapshot under the leaf lock (refcounted keys keep sources alive), then
+  // release it before reading identity through each source's own lock.
+  constexpr size_t kMaxEntries = 32;
+  std::vector<std::pair<scoped_refptr<TaskSource>, int>> snapshot;
+  size_t total = 0;
+  {
+    CheckedAutoLock auto_lock(diagnostics_lock_);
+    total = incomplete_block_shutdown_sources_.size();
+    for (const auto& entry : incomplete_block_shutdown_sources_) {
+      snapshot.emplace_back(entry.first, entry.second);
+      if (snapshot.size() == kMaxEntries) {
+        break;
+      }
+    }
+  }
+  if (total == 0) {
+    return std::string();
+  }
+  std::string result = "Registered incomplete BLOCK_SHUTDOWN task sources:";
+  for (const auto& [source, count] : snapshot) {
+    std::string identity;
+    if (source->execution_mode() == TaskSourceExecutionMode::kJob) {
+      identity =
+          "job created from: " + static_cast<const JobTaskSource*>(source.get())
+                                     ->posted_from_for_testing()
+                                     .ToString();
+    } else {
+      std::optional<Location> posted_from =
+          static_cast<Sequence*>(source.get())
+              ->PeekFrontTaskPostedFromForTesting();
+      identity = posted_from.has_value()
+                     ? "task posted from: " + posted_from->ToString()
+                     : "[no queued task - task popped or in flight]";
+    }
+    result +=
+        base::StringPrintf("\n  registrations=%d %s", count, identity.c_str());
+  }
+  if (total > snapshot.size()) {
+    result += base::StringPrintf("\n  (+%zu more)", total - snapshot.size());
+  }
+  return result;
+}
