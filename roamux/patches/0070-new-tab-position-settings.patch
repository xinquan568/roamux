+            </div>
+            <settings-dropdown-menu id="roamuxNewTabPosition"
+                label="New tab position"
+                pref="{{prefs.roamux.tabs.new_tab_position}}"
+                menu-options="[[roamuxNewTabPositionOptions_(
+                    prefs.roamux.tabs.strip_position.value,
+                    prefs.vertical_tabs.enabled.value)]]">
+            </settings-dropdown-menu>
+          </div>
+        </template>
+
         <template is="dom-if" if="[[roamuxSigninOptInEnabled_]]">
           <settings-toggle-button id="roamuxSigninOptIn"
               pref="{{prefs.roamux.signin.optional_entry_point_enabled}}"
