# roam-277: the Settings > Appearance "New tab position" dropdown — the v1
# UI for roamux.tabs.new_tab_position. Mechanism: the maintainer-authorised
# patch-0006 §12.2 revision (at M149 the chromium_src include-redirect cannot
# reach build_webui() resource lists), so the surface is this minimal patch.
#
# FOUR files: (1) chrome/browser/extensions/api/settings_private/prefs_util.cc
# — the settings_private allowlist row (kNumber) so the dropdown's pref
# binding reads/writes live; (2) chrome/browser/ui/webui/settings/
# settings_localized_strings_provider.cc — `roamuxNewTabPositionEnabled`
# loadTimeData, gating the row on kNewTabPosition ALONE (independent of
# kTabStripPosition: turning the strip-position feature off must not hide
# this control); (3) appearance_page.html — the row, placed directly under
# the 0006 "Tab strip position" block (ORDERING DEPENDENCY: the hunk's
# context is 0006's closing lines and 0024's opening line, so this patch
# stays AFTER 0006 and 0024 in name order; a rebase of either must re-verify
# it); (4) appearance_page.ts — THREE hunks: the gate property, its class-field
# declaration, and roamuxNewTabPositionOptions_().
#
# PRESENTATION-AWARE COPY (issue design §1): internal names are logical
# (end / after); the after-active option reads "Below the current tab" on a
# vertical strip and "To the right / left of the current tab" on a horizontal
# strip in LTR / RTL — upstream's IDS_TAB_CXMENU_NEWTABBELOW / NEWTABTORIGHT /
# NEWTABTOLEFT pattern. The orientation signal is the TS mirror of
# roamux::IsVerticalTabStripEffectivelyEnabled (roam-254): the roamux
# placement (Left=2 / Right=3) when kTabStripPosition is on, upstream
# vertical_tabs.enabled when it is off. Both inputs are Polymer pref bindings,
# so the labels recompute LIVE when the strip-position control on the same
# page changes; `textdirection` comes from every WebUI's loadTimeData defaults
# (ui/base/webui/web_ui_util.cc). Bounded caveat, same as the C++ accessor:
# with kTabStripPosition OFF the label follows vertical_tabs.enabled even if
# the upstream vertical-tabs feature itself is off.
#
# The optional tab-context radio submenu (patch-0005 precedent) is NOT part
# of v1 (follow-up issue if wanted).
#
# Coverage: roamux/test/roamux_new_tab_position_settings_browsertest.cc (row
# present + live-bound both ways; absent when the flag is off; present with
# kTabStripPosition off; labels follow the roamux placement live, follow
# vertical_tabs.enabled live when kTabStripPosition is off, and flip under
# --force-ui-direction=rtl — all RED before this patch) and
# roamux_settings_private_prefs_unittest.cc (allowlist row + default).
diff --git a/chrome/browser/extensions/api/settings_private/prefs_util.cc b/chrome/browser/extensions/api/settings_private/prefs_util.cc
index f2479b7701..b6bd7f9a51 100644
--- a/chrome/browser/extensions/api/settings_private/prefs_util.cc
+++ b/chrome/browser/extensions/api/settings_private/prefs_util.cc
@@ -216,6 +216,10 @@ const PrefsUtil::TypedPrefMap& PrefsUtil::GetAllowlistedKeys() {
       settings_api::PrefType::kNumber;
   (*s_allowlist)["roamux.profiles.external_open_profile"] =
       settings_api::PrefType::kString;
+  // Roamux (roam-277; the key literal mirrors roamux/common/roamux_prefs.h):
+  // the new-tab position enum behind the Appearance dropdown (patch 0070).
+  (*s_allowlist)["roamux.tabs.new_tab_position"] =
+      settings_api::PrefType::kNumber;
 
   // Miscellaneous
   (*s_allowlist)[::embedder_support::kAlternateErrorPagesEnabled] =
diff --git a/chrome/browser/resources/settings/appearance_page/appearance_page.html b/chrome/browser/resources/settings/appearance_page/appearance_page.html
index e5491a4a7b..b122443980 100644
--- a/chrome/browser/resources/settings/appearance_page/appearance_page.html
+++ b/chrome/browser/resources/settings/appearance_page/appearance_page.html
@@ -203,6 +203,24 @@
           </div>
         </template>
 
+        <!-- Roamux (roam-277): where Cmd+T / "+" / File > New Tab insert the
+             new tab. Gated on kNewTabPosition alone; the option copy is
+             orientation- and RTL-aware (roamuxNewTabPositionOptions_). -->
+        <template is="dom-if" if="[[roamuxNewTabPositionEnabled_]]">
+          <div class="cr-row">
+            <div class="flex cr-padded-text" aria-hidden="true">
