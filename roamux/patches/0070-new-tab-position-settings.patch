@@ -347,6 +355,7 @@ export class SettingsAppearancePageElement extends
   declare private roamuxTabStripPositionEnabled_: boolean;
   declare private roamuxSigninOptInEnabled_: boolean;
   declare private roamuxTabStripPositionOptions_: DropdownMenuOptionList;
+  declare private roamuxNewTabPositionEnabled_: boolean;
   declare private colorSchemeModeOptions_:
       Array<{value: ColorSchemeMode, name: string}>;
   declare private selectedColorSchemeMode_: ColorSchemeMode|undefined;
@@ -714,6 +723,30 @@ export class SettingsAppearancePageElement extends
     return placement === 2 || placement === 3;
   }
 
+  // Roamux (roam-277): presentation-aware copy for the new-tab position
+  // dropdown. `vertical` mirrors roamux::IsVerticalTabStripEffectivelyEnabled:
+  // the roamux placement when its flag is on (Left=2 / Right=3), upstream
+  // vertical_tabs.enabled otherwise; both are pref bindings, so the labels
+  // follow a live change on this page. RTL flips right/left (upstream's
+  // IDS_TAB_CXMENU_NEWTABTORIGHT / NEWTABTOLEFT pattern).
+  private roamuxNewTabPositionOptions_(
+      placement: number,
+      upstreamVerticalTabs: boolean): DropdownMenuOptionList {
+    const vertical = loadTimeData.getBoolean('roamuxTabStripPositionEnabled') ?
+        (placement === 2 || placement === 3) :
+        upstreamVerticalTabs;
+    const rtl = loadTimeData.getString('textdirection') === 'rtl';
+    const afterActive = vertical ?
+        'Below the current tab' :
+        (rtl ? 'To the left of the current tab' :
+               'To the right of the current tab');
+    return [
+      {value: 0, name: 'At the end of the tab strip'},
+      {value: 1, name: 'At the end of the current tab\'s group'},
+      {value: 2, name: afterActive},
+    ];
+  }
+
 
   private onManagedDialogClosed_() {
     this.showManagedThemeDialog_ = false;
