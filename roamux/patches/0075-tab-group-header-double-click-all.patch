+  const tab_groups::TabGroupId clicked =
+      GetTabGroupFromNode(collection_node_)->id();
+  base::WeakPtr<VerticalTabGroupView> weak = roamux_weak_factory_.GetWeakPtr();
+  roamux::group_header_double_click::RunDoubleClickAll(
+      clicked, clicked_pre_collapsed,
+      [&]() -> std::optional<roamux::group_header_double_click::Snapshot> {
+        if (!weak) {
+          return std::nullopt;
+        }
+        return weak->SnapshotGroups();
+      },
+      [&](const tab_groups::TabGroupId& id) {
+        if (!weak || !weak->collection_node_) {
