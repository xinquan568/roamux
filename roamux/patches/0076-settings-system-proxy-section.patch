diff --git a/chrome/browser/resources/settings/system_page/roamux_proxy_section.html b/chrome/browser/resources/settings/system_page/roamux_proxy_section.html
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/settings/system_page/roamux_proxy_section.html
@@ -0,0 +1,87 @@
+<!-- Roamux (roam-323): the per-profile proxy section. Thin by design: it renders the state the
+     browser reports and submits raw fields, because every validation and precedence rule is
+     C++-side (//roamux/browser/proxy + RoamuxProxyHandler). The mode-specific rows are always
+     stamped and hidden, so every control exists to be populated from the saved configuration. -->
+<style include="cr-shared-style settings-shared">
+  .field {
+    margin-bottom: 8px;
+  }
+  .error {
+    color: var(--cr-error-color, red);
+  }
+</style>
+<div class="cr-row first">
+  <div class="flex cr-padded-text">
+    <div>$i18n{roamuxProxySectionTitle}</div>
+    <div class="secondary" id="roamuxProxyOwner">[[ownerLabel_(state_)]]</div>
+    <div class="secondary" id="roamuxProxyOverrideRules"
+        hidden$="[[!state_.overrideRulesConfigured]]">
+      [[overrideRulesLabel_(state_)]]
+    </div>
+  </div>
+</div>
+<div class="cr-row continuation">
+  <select id="roamuxProxyMode" class="md-select field"
+      on-change="onModeChange_" disabled$="[[!state_.canEdit]]">
+    <option value="system">$i18n{roamuxProxyModeSystem}</option>
+    <option value="direct">$i18n{roamuxProxyModeDirect}</option>
+    <option value="manual">$i18n{roamuxProxyModeManual}</option>
+    <option value="pac">$i18n{roamuxProxyModePac}</option>
+  </select>
+</div>
+<div class="cr-row continuation" id="roamuxProxyManualFields"
+    hidden$="[[!isManual_(mode_)]]">
+  <select id="roamuxProxyScheme" class="md-select field"
+      on-change="onSchemeChange_" disabled$="[[!state_.canEdit]]">
+    <option value="http">http</option>
+    <option value="https">https</option>
+    <option value="socks5">socks5</option>
+  </select>
+  <cr-input id="roamuxProxyHost" class="field" label="$i18n{roamuxProxyHost}"
+      value="[[form_.host]]" disabled$="[[!state_.canEdit]]"
+      invalid="[[fieldInvalid_('host', errorField_)]]"
+      error-message="[[fieldError_('host', errorField_, errorReason_)]]">
+  </cr-input>
+  <cr-input id="roamuxProxyPort" class="field" label="$i18n{roamuxProxyPort}"
+      value="[[form_.port]]" disabled$="[[!state_.canEdit]]"
+      invalid="[[fieldInvalid_('port', errorField_)]]"
+      error-message="[[fieldError_('port', errorField_, errorReason_)]]">
+  </cr-input>
+  <cr-input id="roamuxProxyBypass" class="field"
+      label="$i18n{roamuxProxyBypass}" value="[[form_.bypassList]]"
+      disabled$="[[!state_.canEdit]]"
+      invalid="[[fieldInvalid_('bypass', errorField_)]]"
+      error-message="[[fieldError_('bypass', errorField_, errorReason_)]]">
+  </cr-input>
+  <div class="secondary">$i18n{roamuxProxySocks5NoAuth}</div>
+  <div class="secondary">$i18n{roamuxProxyHopSecurity}</div>
+</div>
+<div class="cr-row continuation" id="roamuxProxyPacFields"
+    hidden$="[[!isPac_(mode_)]]">
+  <cr-input id="roamuxProxyPacUrl" class="field"
+      label="$i18n{roamuxProxyPacUrl}" value="[[form_.pacUrl]]"
+      disabled$="[[!state_.canEdit]]"
+      invalid="[[fieldInvalid_('pac_url', errorField_)]]"
+      error-message="[[fieldError_('pac_url', errorField_, errorReason_)]]">
+  </cr-input>
+  <cr-checkbox id="roamuxProxyPacMandatory" checked="[[form_.pacMandatory]]"
+      disabled$="[[!state_.canEdit]]">
+    $i18n{roamuxProxyPacMandatory}
+  </cr-checkbox>
+  <div class="secondary">$i18n{roamuxProxyPacDirectFetch}</div>
+</div>
+<div class="cr-row continuation">
+  <cr-button id="roamuxProxyApply" on-click="onApplyClick_"
+      disabled$="[[!state_.canEdit]]">
+    $i18n{roamuxProxyApply}
+  </cr-button>
+  <cr-button id="roamuxProxyReset" on-click="onResetClick_"
+      disabled$="[[!state_.canReset]]">
+    $i18n{roamuxProxyReset}
+  </cr-button>
+</div>
+<div class="cr-row continuation error" id="roamuxProxyError"
+    hidden$="[[!generalError_(errorField_, errorReason_)]]">
+  [[generalError_(errorField_, errorReason_)]]
+</div>
+<div class="cr-row continuation secondary">$i18n{roamuxProxyAuthNote}</div>
diff --git a/chrome/browser/resources/settings/system_page/roamux_proxy_section.ts b/chrome/browser/resources/settings/system_page/roamux_proxy_section.ts
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/settings/system_page/roamux_proxy_section.ts
@@ -0,0 +1,299 @@
+// SPDX-License-Identifier: Apache-2.0
+// Roamux (roam-323). Roamux-authored source living in the upstream resources tree (patch 0076
+// carries it), so it takes the Roamux license header rather than Chromium's.
+
+/**
+ * @fileoverview 'roamux-proxy-section' configures a proxy for THIS profile by handing raw fields
+ * to the browser. It validates nothing itself — RoamuxProxyHandler and //roamux/browser/proxy own
+ * validation, the write, and the truth about who controls routing — so the page cannot store a
+ * half-valid configuration or talk itself out of a guard. What it does own: showing the saved
+ * configuration in the controls (so Apply never has to be re-typed from memory) and turning the
+ * browser's reason token into an explanation next to the field it belongs to.
+ */
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../settings_shared.css.js';
+
+import type {CrCheckboxElement} from 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import type {CrInputElement} from 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import {WebUiListenerMixin} from 'chrome://resources/cr_elements/web_ui_listener_mixin.js';
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './roamux_proxy_section.html.js';
+
+interface ProxyState {
+  mode: string;
+  scheme?: string;
+  host?: string;
+  port?: string;
+  bypassList?: string;
+  pacUrl?: string;
+  pacMandatory?: boolean;
+  baseOwner: string;
+  controllerName?: string;
+  extensionScope?: string;
+  overrideRulesConfigured?: boolean;
+  overrideRulesActive?: boolean;
+  overrideRulesOwner?: string;
+  canEdit?: boolean;
+  canReset?: boolean;
+}
+
+interface ProxyForm {
+  scheme: string;
+  host: string;
+  port: string;
+  bypassList: string;
+  pacUrl: string;
+  pacMandatory: boolean;
+}
+
+interface ProxyError {
+  field?: string;
+  reason?: string;
+}
+
+// The browser's rejection tokens (proxy_config_builder.h) in the user's words. `bypass` is absent
+// on purpose: its reason carries the offending entry, so it is formatted with it.
+const REASON_STRINGS: {[reason: string]: string} = {
+  scheme: 'roamuxProxyErrorScheme',
+  host: 'roamuxProxyErrorHost',
+  port: 'roamuxProxyErrorPort',
+  userinfo: 'roamuxProxyErrorUserinfo',
+  socks5_no_auth: 'roamuxProxyErrorSocks5NoAuth',
+  list_syntax: 'roamuxProxyErrorListSyntax',
+  not_an_endpoint: 'roamuxProxyErrorNotAnEndpoint',
+  pac_url: 'roamuxProxyErrorPacUrl',
+  pac_scheme: 'roamuxProxyErrorPacScheme',
+  pac_data_url: 'roamuxProxyErrorPacDataUrl',
+  mode: 'roamuxProxyErrorMode',
+  incognito: 'roamuxProxyErrorIncognito',
+  policy: 'roamuxProxyErrorPolicy',
+  extension: 'roamuxProxyErrorExtension',
+};
+
+export interface RoamuxProxySectionElement {
+  $: {
+    roamuxProxyMode: HTMLSelectElement,
+    roamuxProxyScheme: HTMLSelectElement,
+    roamuxProxyHost: CrInputElement,
+    roamuxProxyPort: CrInputElement,
+    roamuxProxyBypass: CrInputElement,
+    roamuxProxyPacUrl: CrInputElement,
+    roamuxProxyPacMandatory: CrCheckboxElement,
+  };
+}
+
+const RoamuxProxySectionElementBase = WebUiListenerMixin(PolymerElement);
+
+export class RoamuxProxySectionElement extends RoamuxProxySectionElementBase {
+  static get is() {
+    return 'roamux-proxy-section';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      state_: Object,
+      form_: Object,
+      // The selector the user is looking at, which is not yet a stored value: manual and PAC wait
+      // for Apply.
+      mode_: {type: String, value: 'system'},
+      errorField_: {type: String, value: ''},
+      errorReason_: {type: String, value: ''},
+    };
+  }
+
+  declare private state_: ProxyState;
+  declare private form_: ProxyForm;
+  declare private mode_: string;
+  declare private errorField_: string;
+  declare private errorReason_: string;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    // WebUiListenerMixin removes this on disconnect: a detached section must not be kept alive by
+    // the callback, and a reattached one must not end up subscribed twice.
+    this.addWebUiListener(
+        'roamux-proxy-state-changed',
+        (state: ProxyState) => this.onState_(state));
+    sendWithPromise<ProxyState>('roamuxProxyGetState')
+        .then(state => this.onState_(state));
+  }
+
+  private onState_(state: ProxyState) {
+    this.state_ = state;
+    this.mode_ = state.mode;
+    // Every control is populated from the browser's answer. Reopening the page — or an external
+    // change — must not leave an empty field that Apply would then store, or silently drop a
+    // bypass list the user never touched.
+    this.form_ = {
+      scheme: state.scheme || 'http',
+      host: state.host || '',
+      port: state.port || '',
+      bypassList: state.bypassList || '',
+      pacUrl: state.pacUrl || '',
+      // An existing PAC configuration reports what the network layer will actually do; only a new
+      // one starts at mandatory.
+      pacMandatory: state.mode === 'pac' ? state.pacMandatory !== false : true,
+    };
+    this.errorField_ = '';
+    this.errorReason_ = '';
+    this.syncSelects_();
+  }
+
+  /**
+   * A native <select> does not follow a Polymer value binding reliably (its options are stamped by
+   * the same template), so the two selectors are set from the model here.
+   */
+  private syncSelects_() {
+    this.$.roamuxProxyMode.value = this.mode_;
+    this.$.roamuxProxyScheme.value = this.form_.scheme;
+  }
+
+  private isManual_(mode: string): boolean {
+    return mode === 'manual';
+  }
+
+  private isPac_(mode: string): boolean {
+    return mode === 'pac';
+  }
+
+  /** What actually controls routing — never a guess from pref metadata alone. */
+  private ownerLabel_(state: ProxyState): string {
+    if (!state) {
+      return '';
+    }
+    switch (state.baseOwner) {
+      case 'policy':
+        return loadTimeData.getString('roamuxProxyOwnerPolicy');
+      case 'extension':
+        // In an incognito window the browser can only name the extension controlling the regular
+        // profile's value, so the copy says exactly that instead of claiming more.
+        return loadTimeData.getStringF(
+            state.extensionScope === 'regular_profile' ?
+                'roamuxProxyOwnerExtensionRegularProfile' :
+                'roamuxProxyOwnerExtension',
+            state.controllerName || '');
+      case 'recommended':
+        return loadTimeData.getString('roamuxProxyOwnerRecommended');
+      case 'roamux':
+        return loadTimeData.getString('roamuxProxyOwnerRoamux');
+      default:
+        return loadTimeData.getString('roamuxProxyOwnerSystem');
+    }
+  }
+
+  /** Configured is not the same as in effect; the browser reports both. */
+  private overrideRulesLabel_(state: ProxyState): string {
+    if (!state || !state.overrideRulesConfigured) {
+      return '';
+    }
+    const owner = loadTimeData.getString(
+        state.overrideRulesOwner === 'policy' ?
+            'roamuxProxyRulesOwnerPolicy' :
+            (state.overrideRulesOwner === 'extension' ?
+                 'roamuxProxyRulesOwnerExtension' :
+                 'roamuxProxyRulesOwnerUser'));
+    return loadTimeData.getStringF(
+        state.overrideRulesActive ? 'roamuxProxyOverrideRulesActive' :
+                                    'roamuxProxyOverrideRulesIgnored',
+        owner);
+  }
+
+  private explain_(field: string, reason: string): string {
+    if (!reason) {
+      return '';
+    }
+    if (field === 'bypass') {
+      return loadTimeData.getStringF('roamuxProxyErrorBypass', reason);
+    }
+    const key = REASON_STRINGS[reason];
+    // An unmapped token is still shown: a silent field is worse than a terse one.
+    return key ? loadTimeData.getString(key) : reason;
+  }
+
+  private fieldInvalid_(field: string, errorField: string): boolean {
+    return !!errorField && errorField === field;
+  }
+
+  private fieldError_(field: string, errorField: string, errorReason: string):
+      string {
+    return errorField === field ? this.explain_(errorField, errorReason) : '';
+  }
+
+  /** Errors that belong to no single input (mode, and the guard refusals). */
+  private generalError_(errorField: string, errorReason: string): string {
+    return errorReason && errorField === 'mode' ?
+        this.explain_(errorField, errorReason) :
+        '';
+  }
+
+  private fieldsFromControls_(): {[key: string]: string|boolean} {
+    return {
+      mode: this.mode_,
+      scheme: this.$.roamuxProxyScheme.value,
+      host: this.$.roamuxProxyHost.value,
+      port: this.$.roamuxProxyPort.value,
+      bypassList: this.$.roamuxProxyBypass.value,
+      pacUrl: this.$.roamuxProxyPacUrl.value,
+      pacMandatory: this.$.roamuxProxyPacMandatory.checked,
+    };
+  }
+
+  private setError_(error: ProxyError|null) {
+    this.errorField_ = error && error.field ? error.field : '';
+    this.errorReason_ = error && error.reason ? error.reason : '';
+  }
+
+  private async submit_(fields: {[key: string]: string|boolean}) {
+    const error = await sendWithPromise<ProxyError>('roamuxProxySet', fields);
+    this.setError_(error);
+    if (!this.errorReason_) {
+      this.onState_(await sendWithPromise<ProxyState>('roamuxProxyGetState'));
+    }
+  }
+
+  private onModeChange_() {
+    // Switching to system or direct needs no other field, so it commits immediately; the editable
+    // modes wait for Apply.
+    this.mode_ = this.$.roamuxProxyMode.value;
+    this.setError_(null);
+    if (this.mode_ === 'system' || this.mode_ === 'direct') {
+      this.submit_({mode: this.mode_});
+    }
+  }
+
+  private onSchemeChange_() {
+    this.form_ = Object.assign(
+        {}, this.form_, {scheme: this.$.roamuxProxyScheme.value});
+  }
+
+  private onApplyClick_() {
+    this.submit_(this.fieldsFromControls_());
+  }
+
+  private async onResetClick_() {
+    const error = await sendWithPromise<ProxyError>('roamuxProxyReset');
+    this.setError_(error);
+    if (!this.errorReason_) {
+      this.onState_(await sendWithPromise<ProxyState>('roamuxProxyGetState'));
+    }
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'roamux-proxy-section': RoamuxProxySectionElement;
+  }
+}
+
+customElements.define(RoamuxProxySectionElement.is, RoamuxProxySectionElement);
