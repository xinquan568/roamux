diff --git a/chrome/browser/resources/settings/system_page/roamux_proxy_section.html b/chrome/browser/resources/settings/system_page/roamux_proxy_section.html
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/settings/system_page/roamux_proxy_section.html
@@ -0,0 +1,73 @@
+<!-- Roamux (roam-323): the per-profile proxy section. Deliberately thin: it renders the state
+     the browser reports and submits raw fields, because every validation and precedence rule is
+     C++-side (//roamux/browser/proxy + RoamuxProxyHandler). -->
+<style include="cr-shared-style settings-shared">
+  .field {
+    margin-bottom: 8px;
+  }
+  .error {
+    color: var(--cr-error-color, red);
+  }
+</style>
+<div class="cr-row first">
+  <div class="flex cr-padded-text">
+    <div>$i18n{roamuxProxySectionTitle}</div>
+    <div class="secondary" id="roamuxProxyOwner">[[ownerLabel_(state_)]]</div>
+    <div class="secondary" id="roamuxProxyOverrideRules"
+        hidden$="[[!state_.overrideRulesConfigured]]">
+      $i18n{roamuxProxyOverrideRules}
+    </div>
+  </div>
+</div>
+<div class="cr-row continuation">
+  <select id="roamuxProxyMode" class="md-select field"
+      value="[[state_.mode]]" on-change="onModeChange_"
+      disabled$="[[!state_.canEdit]]">
+    <option value="system">$i18n{roamuxProxyModeSystem}</option>
+    <option value="direct">$i18n{roamuxProxyModeDirect}</option>
+    <option value="manual">$i18n{roamuxProxyModeManual}</option>
+    <option value="pac">$i18n{roamuxProxyModePac}</option>
+  </select>
+</div>
+<template is="dom-if" if="[[isManual_(state_)]]" restamp>
+  <div class="cr-row continuation">
+    <select id="roamuxProxyScheme" class="md-select field">
+      <option value="http">http</option>
+      <option value="https">https</option>
+      <option value="socks5">socks5</option>
+    </select>
+    <cr-input id="roamuxProxyHost" class="field" label="$i18n{roamuxProxyHost}">
+    </cr-input>
+    <cr-input id="roamuxProxyPort" class="field" label="$i18n{roamuxProxyPort}">
+    </cr-input>
+    <cr-input id="roamuxProxyBypass" class="field"
+        label="$i18n{roamuxProxyBypass}"></cr-input>
+    <div class="secondary">$i18n{roamuxProxySocks5NoAuth}</div>
+    <div class="secondary">$i18n{roamuxProxyHopSecurity}</div>
+  </div>
+</template>
+<template is="dom-if" if="[[isPac_(state_)]]" restamp>
+  <div class="cr-row continuation">
+    <cr-input id="roamuxProxyPacUrl" class="field"
+        label="$i18n{roamuxProxyPacUrl}"></cr-input>
+    <cr-checkbox id="roamuxProxyPacMandatory" checked="{{pacMandatory_}}">
+      $i18n{roamuxProxyPacMandatory}
+    </cr-checkbox>
+    <div class="secondary">$i18n{roamuxProxyPacDirectFetch}</div>
+  </div>
+</template>
+<div class="cr-row continuation">
+  <cr-button id="roamuxProxyApply" on-click="onApplyClick_"
+      disabled$="[[!state_.canEdit]]">
+    $i18n{roamuxProxyApply}
+  </cr-button>
+  <cr-button id="roamuxProxyReset" on-click="onResetClick_"
+      disabled$="[[!state_.canReset]]">
+    $i18n{roamuxProxyReset}
+  </cr-button>
+</div>
+<div class="cr-row continuation error" id="roamuxProxyError"
+    hidden$="[[!errorReason_]]">
+  [[errorText_(errorField_, errorReason_)]]
+</div>
+<div class="cr-row continuation secondary">$i18n{roamuxProxyAuthNote}</div>
diff --git a/chrome/browser/resources/settings/system_page/roamux_proxy_section.ts b/chrome/browser/resources/settings/system_page/roamux_proxy_section.ts
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/settings/system_page/roamux_proxy_section.ts
@@ -0,0 +1,196 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+/**
+ * Roamux (roam-323): 'roamux-proxy-section' configures a proxy for THIS profile by handing raw
+ * fields to the browser. It validates nothing itself — RoamuxProxyHandler and
+ * //roamux/browser/proxy own validation, the write, and the truth about who controls routing —
+ * so the page cannot store a half-valid configuration or talk itself out of a guard.
+ */
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_checkbox/cr_checkbox.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../settings_shared.css.js';
+
+import {addWebUiListener, sendWithPromise} from 'chrome://resources/js/cr.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './roamux_proxy_section.html.js';
+
+interface ProxyState {
+  mode: string;
+  scheme?: string;
+  host?: string;
+  port?: string;
+  bypassList?: string;
+  pacUrl?: string;
+  pacMandatory?: boolean;
+  baseOwner: string;
+  controllerName?: string;
+  overrideRulesConfigured?: boolean;
+  overrideRulesActive?: boolean;
+  canEdit?: boolean;
+  canReset?: boolean;
+}
+
+interface ProxyError {
+  field?: string;
+  reason?: string;
+}
+
+export interface RoamuxProxySectionElement {
+  $: {
+    roamuxProxyMode: HTMLSelectElement,
+  };
+}
+
+export class RoamuxProxySectionElement extends PolymerElement {
+  static get is() {
+    return 'roamux-proxy-section';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      state_: Object,
+      errorField_: String,
+      errorReason_: String,
+      pacMandatory_: {type: Boolean, value: true},
+    };
+  }
+
+  declare private state_: ProxyState;
+  declare private errorField_: string;
+  declare private errorReason_: string;
+  declare private pacMandatory_: boolean;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    addWebUiListener(
+        'roamux-proxy-state-changed',
+        (state: ProxyState) => this.onState_(state));
+    sendWithPromise<ProxyState>('roamuxProxyGetState')
+        .then(state => this.onState_(state));
+  }
+
+  private onState_(state: ProxyState) {
+    this.state_ = state;
+    this.pacMandatory_ = state.pacMandatory !== false;
+  }
+
+  private isManual_(state: ProxyState): boolean {
+    return !!state && state.mode === 'manual';
+  }
+
+  private isPac_(state: ProxyState): boolean {
+    return !!state && state.mode === 'pac';
+  }
+
+  /** What actually controls routing — never a guess from pref metadata alone. */
+  private ownerLabel_(state: ProxyState): string {
+    if (!state) {
+      return '';
+    }
+    switch (state.baseOwner) {
+      case 'policy':
+        return loadTimeData.getString('roamuxProxyOwnerPolicy');
+      case 'extension':
+        return loadTimeData.getStringF(
+            'roamuxProxyOwnerExtension', state.controllerName || '');
+      case 'recommended':
+        return loadTimeData.getString('roamuxProxyOwnerRecommended');
+      case 'roamux':
+        return loadTimeData.getString('roamuxProxyOwnerRoamux');
+      default:
+        return loadTimeData.getString('roamuxProxyOwnerSystem');
+    }
+  }
+
+  private errorText_(field: string, reason: string): string {
+    return field && reason ? `${field}: ${reason}` : '';
+  }
+
+  private fieldsFromForm_(mode: string): {[key: string]: string|boolean} {
+    const value = (id: string) => {
+      const el = this.shadowRoot!.querySelector<HTMLInputElement>('#' + id);
+      return el ? el.value : '';
+    };
+    return {
+      mode: mode,
+      scheme: value('roamuxProxyScheme') || 'http',
+      host: value('roamuxProxyHost'),
+      port: value('roamuxProxyPort'),
+      bypassList: value('roamuxProxyBypass'),
+      pacUrl: value('roamuxProxyPacUrl'),
+      pacMandatory: this.pacMandatory_,
+    };
+  }
+
+  private async submit_(fields: {[key: string]: string|boolean}) {
+    const error = await sendWithPromise<ProxyError>('roamuxProxySet', fields);
+    this.errorField_ = error && error.field ? error.field : '';
+    this.errorReason_ = error && error.reason ? error.reason : '';
+    if (!this.errorReason_) {
+      this.onState_(await sendWithPromise<ProxyState>('roamuxProxyGetState'));
+    }
+  }
+
+  private onModeChange_() {
+    // Switching to system or direct needs no other field, so it commits immediately; the
+    // editable modes wait for Apply.
+    const mode = this.$.roamuxProxyMode.value;
+    this.state_ = Object.assign({}, this.state_, {mode: mode});
+    if (mode === 'system' || mode === 'direct') {
+      this.submit_({mode: mode});
+    }
+  }
+
+  private onApplyClick_() {
+    this.submit_(this.fieldsFromForm_(this.state_.mode));
+  }
+
+  private async onResetClick_() {
+    const error = await sendWithPromise<ProxyError>('roamuxProxyReset');
+    this.errorField_ = error && error.field ? error.field : '';
+    this.errorReason_ = error && error.reason ? error.reason : '';
+    this.onState_(await sendWithPromise<ProxyState>('roamuxProxyGetState'));
+  }
+
+  // ---- test seams (roamux_proxy_settings_browsertest.cc drives these) ----
+
+  async setModeForTesting(mode: string, fields: {[key: string]: string}) {
+    await this.submit_(Object.assign(
+        {mode: mode, pacMandatory: this.pacMandatory_}, fields));
+  }
+
+  async resetForTesting() {
+    await this.onResetClick_();
+  }
+
+  errorFieldForTesting(): string {
+    return this.errorField_;
+  }
+
+  errorReasonForTesting(): string {
+    return this.errorReason_;
+  }
+
+  baseOwnerForTesting(): string {
+    return this.state_ ? this.state_.baseOwner : '';
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'roamux-proxy-section': RoamuxProxySectionElement;
+  }
+}
+
+customElements.define(RoamuxProxySectionElement.is, RoamuxProxySectionElement);
